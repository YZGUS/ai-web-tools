{
  "name": "ai-web-tools",
  "version": "0.1.0",
  "private": true,
  "description": "AI Web 端常用工具集成：Gemini / Grok / ChatGPT / 小云雀(Seedream) / 千问 / Claude",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./gemini": "./providers/gemini/index.mjs",
    "./chatgpt": "./providers/chatgpt/index.mjs",
    "./grok": "./providers/grok/index.mjs",
    "./xyq": "./providers/xyq/index.mjs",
    "./shared": "./shared/index.mjs"
  },
  "scripts": {
    "cli": "node interfaces/cli/cli.mjs",
    "chrome:start": "bash scripts/chrome-start.sh",
    "chrome:check": "bash scripts/chrome-check.sh",
    "gemini:chat": "node interfaces/cli/cli.mjs gemini chat",
    "gemini:explore": "node interfaces/cli/cli.mjs gemini explore",
    "chatgpt:chat": "node interfaces/cli/cli.mjs chatgpt chat",
    "chatgpt:image": "node interfaces/cli/cli.mjs chatgpt image",
    "chatgpt:explore": "node interfaces/cli/cli.mjs chatgpt explore",
    "grok:image": "node interfaces/cli/cli.mjs grok image",
    "grok:video": "node interfaces/cli/cli.mjs grok video",
    "grok:explore": "node interfaces/cli/cli.mjs grok explore",
    "xyq:image": "node interfaces/cli/cli.mjs xyq image",
    "xyq:explore": "node interfaces/cli/cli.mjs xyq explore",
    "xyq:credits": "node interfaces/cli/cli.mjs xyq credits",
    "test:xyq:e2e": "node tests/providers/xyq/e2e-combo.mjs",
    "test:xyq:bot": "node tests/providers/xyq/bot-tools.mjs",
    "status": "node interfaces/cli/cli.mjs status",
    "probe": "node interfaces/cli/cli.mjs probe",
    "test:smoke": "node tests/smoke/cdp.mjs",
    "test:gemini": "node tests/providers/gemini/full-suite.mjs",
    "test:gemini:quick": "node tests/providers/gemini/full-suite.mjs --quick",
    "test:gemini:e2e": "node tests/providers/gemini/e2e.mjs",
    "test:gemini:media": "node tests/providers/gemini/media.mjs",
    "test:gemini:bot": "node tests/providers/gemini/bot-tools.mjs"
  },

  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer-core": "^25.2.1"
  },
  "keywords": [
    "ai",
    "gemini",
    "grok",
    "chatgpt",
    "seedream",
    "xyq",
    "browser-automation",
    "telegram"
  ]
}
